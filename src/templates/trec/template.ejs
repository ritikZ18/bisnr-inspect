<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title>TREC Inspection Report</title>
<script src="https://cdn.tailwindcss.com"></script>

<style>
@media print {
  .page-break { page-break-before: always; }

  .print-header, .print-footer {
    position: fixed;
    left: 0; right: 0;
    font-size: 11px;
    background: white;
    z-index: 999;
  }

  .print-header {
    top: 0;
    padding: 6px 0;
    border-bottom: 1px solid #000;
  }

  .print-footer {
    bottom: 0;
    padding: 6px 0;
    border-top: 1px solid #000;
  }

  body {
    margin-top: 90px; 
    margin-bottom: 70px;
  }
}
</style>
</head>

<body class="font-serif text-base leading-relaxed">

<!-- ===== 🧾 PAGE HEADER (Repeats every page) ===== -->
<div class="print-header text-center">
  <div class="font-bold">
    Report Identification: <%= data.property.address %> — <%= formatDate(data.property.inspectionDate) %>
  </div>
  <div>
    I=Inspected &nbsp;&nbsp; NI=Not Inspected &nbsp;&nbsp;
    NP=Not Present &nbsp;&nbsp; D=Deficient
  </div>
</div>

<div class="container mx-auto p-8">

<!-- ===== DOCUMENT TITLE ===== -->
<header class="text-center mb-8">
  <h1 class="text-3xl font-bold">TREC PROPERTY INSPECTION REPORT</h1>
</header>



<!-- ===== PROPERTY INFO ===== -->
<div class="border border-black mt-10 mb-8 text-sm leading-tight w-full">

  <div class="flex border-b border-black">
    <div class="w-1/2 p-2 border-r border-black">
      <div class="font-semibold">Buyer Name</div>
      <div><%= data.property.client %></div>
    </div>
    <div class="w-1/2 p-2">
      <div class="font-semibold">Date of Inspection</div>
      <div><%= formatDateTime(data.property.inspectionDate) %></div>
    </div>
  </div>

  <div class="flex border-b border-black">
    <div class="w-1/2 p-2 border-r border-black">
      <div class="font-semibold">Name of Client</div>
      <div><%= data.property.client %></div>
    </div>
    <div class="w-1/2 p-2">
      <div class="font-semibold">TREC License #</div>
      <div><%= data.property.inspectorLicense || "_____" %></div>
    </div>
  </div>

  <div class="flex border-b border-black">
    <div class="w-1/2 p-2 border-r border-black">
      <div class="font-semibold">Address of Inspected Property</div>
      <div><%= data.property.address %></div>
    </div>
    <div class="w-1/2 p-2">
      <div class="font-semibold">TREC License #</div>
      <div>____</div>
    </div>
  </div>

  <div class="flex border-b border-black">
    <div class="w-1/2 p-2 border-r border-black">
      <div class="font-semibold">Name of Inspector</div>
      <div><%= data.property.inspector %></div>
    </div>
    <div class="w-1/2 p-2">
      <div class="font-semibold">TREC License #</div>
      <div><%= data.property.inspectorLicense || "_____" %></div>
    </div>
  </div>

  <div class="flex">
    <div class="w-1/2 p-2 border-r border-black">
      <div class="font-semibold">Name of Sponsor (if applicable)</div>
      <div><%= data.property.sponsor || "N/A" %></div>
    </div>
    <div class="w-1/2 p-2">
      <!-- blank cell intentionally -->
    </div>
  </div>
</div>



<!-- ===== INTRO ===== -->
<div class="mb-8">
  <p><strong>PURPOSE OF INSPECTION:</strong>
  This inspection is a visual survey… Ask the inspector to clarify any items or comments that are unclear.</p>
</div>

<!-- ===== LEGEND ===== -->
<div class="legend mb-8 p-4 border border-gray-300 rounded">
  <p><strong>I</strong> = Inspected,
     <strong>NI</strong> = Not Inspected,
     <strong>NP</strong> = Not Present,
     <strong>D</strong> = Deficient</p>
</div>

<!-- ===== SECTIONS LOOP ===== -->
<% data.sections.forEach(section => { %>

<div class="section mb-10 page-break">
  <h2 class="text-xl font-bold border-b-2 border-gray-300 pb-2 mb-4">
    <%= section.name %>
  </h2>

  <% section.lineItems.forEach(item => { %>
  <div class="mb-6">

    <!-- Line Item Header -->
    <div class="flex justify-between items-center">
      <h3 class="text-lg font-semibold"><%= item.name %></h3>

      <!-- PDF Style Checkboxes -->
      <div class="flex space-x-6 text-lg font-bold">
        <% ['I','NI','NP','D'].forEach(code => { %>
        <span class="flex items-center space-x-1">
          <% if (item.status === code) { %><span>☑</span><% } else { %><span>☐</span><% } %>
          <span><%= code %></span>
        </span>
        <% }) %>
      </div>
    </div>

    <!-- Severity Label -->
    <% if (item.category) { %>
      <div class="mt-1 text-sm font-semibold
        <% if (item.category=='Minor') { %>text-blue-600<% } %>
        <% if (item.category=='Marginal') { %>text-orange-600<% } %>
        <% if (item.category=='Major') { %>text-red-600<% } %>">

        <% if (item.category=='Minor') { %>⚙️ Minor Concerns / FYI<% } %>
        <% if (item.category=='Marginal') { %>⚠️ Marginal Concerns<% } %>
        <% if (item.category=='Major') { %>⛔ Significant / Major Concerns<% } %>
      </div>
    <% } %>

    <!-- Comments + Photos -->
    <% if (item.comments && item.comments.length) { %>
      <div class="mt-2 pl-4 border-l-2 border-gray-300">

        <% item.comments.forEach(comment => { %>

          <p class="text-gray-800 mb-2"><%= comment.text %></p>

          <% if (comment.photos && comment.photos.length) { %>
          <div class="grid grid-cols-3 gap-2 mt-2">
            <% comment.photos.forEach(photo => { %>
              <img
                src="<%= photo.url %>"
                alt="Photo"
                class="w-full h-auto rounded shadow border border-gray-300"
              />
            <% }) %>
          </div>
          <% } %>

        <% }) %>

      </div>
    <% } %>

  </div>
  <% }) %>

</div>

<% }) %>

</div>

<!-- ===== FOOTER (Repeats every page) ===== -->
<div class="print-footer text-center text-xs">
  REI 7-6 (8/9/2021) • Promulgated by the Texas Real Estate Commission • (512) 936-3000 • www.trec.texas.gov
  <br/>
  Page <span class="pageNumber"></span> of <span class="totalPages"></span>
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const pages = document.querySelectorAll(".page-break");
  document.querySelectorAll(".totalPages").forEach(el => el.textContent = pages.length);
});

