<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Professional Home Inspection Report</title>
  <style>
    @page {
      size: letter;
      margin: 0.5in;
    }
    
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      font-size: 11pt;
      line-height: 1.6;
      color: #333;
    }
    
    /* Cover Page */
    .cover-page {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      height: 100vh;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      page-break-after: always;
    }
    
    .cover-page h1 {
      font-size: 36pt;
      margin-bottom: 20px;
      text-align: center;
    }
    
    .cover-page .property-address {
      font-size: 18pt;
      margin-bottom: 40px;
    }
    
    .cover-page .date {
      font-size: 14pt;
    }
    
    /* Executive Summary */
    .executive-summary {
      page-break-after: always;
      padding: 30px;
    }
    
    .summary-header {
      background: #f8f9fa;
      padding: 20px;
      border-left: 5px solid #667eea;
      margin-bottom: 30px;
    }
    
    .summary-header h2 {
      color: #667eea;
      margin-bottom: 10px;
    }
    
    .condition-badge {
      display: inline-block;
      padding: 10px 20px;
      border-radius: 25px;
      font-weight: bold;
      font-size: 14pt;
      margin: 20px 0;
    }
    
    .condition-excellent { background: #28a745; color: white; }
    .condition-good { background: #17a2b8; color: white; }
    .condition-fair { background: #ffc107; color: #333; }
    .condition-attention { background: #dc3545; color: white; }
    
    /* Statistics Grid */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin: 30px 0;
    }
    
    .stat-card {
      background: #f8f9fa;
      padding: 20px;
      border-radius: 10px;
      text-align: center;
    }
    
    .stat-number {
      font-size: 24pt;
      font-weight: bold;
      color: #667eea;
    }
    
    .stat-label {
      font-size: 10pt;
      color: #6c757d;
    }
    
    /* Table of Contents */
    .table-of-contents {
      margin: 30px 0;
      page-break-after: always;
    }
    
    .toc-item {
      display: flex;
      justify-content: space-between;
      padding: 10px;
      border-bottom: 1px dotted #dee2e6;
    }
    
    .toc-item:hover {
      background: #f8f9fa;
    }
    
    /* Sections */
    .inspection-section {
      margin-bottom: 30px;
      page-break-inside: avoid;
    }
    
    .section-header {
      background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 15px;
      border-radius: 5px 5px 0 0;
    }
    
    .section-content {
      border: 1px solid #dee2e6;
      border-top: none;
      padding: 20px;
      border-radius: 0 0 5px 5px;
    }
    
    .issue-card {
      background: #fff3cd;
      border-left: 4px solid #ffc107;
      padding: 15px;
      margin: 15px 0;
      border-radius: 5px;
    }
    
    .issue-critical {
      background: #f8d7da;
      border-left-color: #dc3545;
    }
    
    .issue-major {
      background: #fff3cd;
      border-left-color: #ffc107;
    }
    
    .issue-minor {
      background: #d1ecf1;
      border-left-color: #17a2b8;
    }
    
    .photo-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin: 15px 0;
    }
    
    .photo-grid img {
      width: 100%;
      height: 150px;
      object-fit: cover;
      border-radius: 5px;
      border: 1px solid #dee2e6;
    }
    
    /* Charts placeholder */
    .chart-container {
      background: #f8f9fa;
      padding: 20px;
      border-radius: 10px;
      margin: 20px 0;
      text-align: center;
      min-height: 200px;
    }
    
    /* Footer */
    .report-footer {
      text-align: center;
      padding: 20px;
      color: #6c757d;
      font-size: 9pt;
      margin-top: 50px;
    }
  </style>
</head>
<body>
  <!-- Cover Page -->
  <div class="cover-page">
    <h1>Professional Home Inspection Report</h1>
    <div class="property-address"><%= data.property.address %></div>
    <div class="date">Inspection Date: <%= data.property.inspectionDate %></div>
    <div style="margin-top: 40px;">
      <p>Prepared for: <%= data.property.client %></p>
      <p>Inspector: <%= data.property.inspector %></p>
    </div>
  </div>

  <!-- Executive Summary -->
  <div class="executive-summary">
    <div class="summary-header">
      <h2>Executive Summary</h2>
      <p>Property Condition Assessment</p>
    </div>
    
    <div class="condition-badge condition-<%= data.executiveSummary.propertyCondition.toLowerCase().replace(' ', '-') %>">
      Overall Condition: <%= data.executiveSummary.propertyCondition %>
    </div>
    
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-number"><%= data.metadata.totalSections %></div>
        <div class="stat-label">Systems Inspected</div>
      </div>
      <div class="stat-card">
        <div class="stat-number"><%= data.summary.deficientItems %></div>
        <div class="stat-label">Items Needing Attention</div>
      </div>
      <div class="stat-card">
        <div class="stat-number"><%= data.metadata.totalImages %></div>
        <div class="stat-label">Photos Documented</div>
      </div>
      <div class="stat-card">
        <div class="stat-number"><%= data.summary.inspectedItems %></div>
        <div class="stat-label">Components Checked</div>
      </div>
    </div>

    <% if (data.executiveSummary.majorConcerns.length > 0) { %>
      <h3 style="color: #dc3545; margin-top: 30px;">⚠️ Major Concerns</h3>
      <ul style="padding-left: 20px;">
        <% data.executiveSummary.majorConcerns.forEach(concern => { %>
          <li style="margin: 10px 0;">
            <strong><%= concern.section %>:</strong> <%= concern.item %>
          </li>
        <% }) %>
      </ul>
    <% } %>

    <% if (data.executiveSummary.recommendedActions.length > 0) { %>
      <h3 style="margin-top: 30px;">📋 Recommended Actions</h3>
      <ol style="padding-left: 20px;">
        <% data.executiveSummary.recommendedActions.forEach(action => { %>
          <li style="margin: 10px 0;"><%= action %></li>
        <% }) %>
      </ol>
    <% } %>
  </div>

  <!-- Table of Contents -->
  <div class="table-of-contents">
    <h2 style="color: #667eea; margin-bottom: 20px;">Table of Contents</h2>
    <% data.tableOfContents.forEach(item => { %>
      <div class="toc-item">
        <span><%= item.number %>. <%= item.name %></span>
        <span style="color: #6c757d;">Page <%= item.page %></span>
      </div>
    <% }) %>
  </div>

  <!-- Severity Distribution Chart -->
  <div style="page-break-before: always;">
    <h2 style="color: #667eea; margin-bottom: 20px;">Issue Severity Distribution</h2>
    <div class="chart-container">
      <h3>Severity Breakdown</h3>
      <p style="margin-top: 20px;">
        Critical: <%= data.severityCategories.critical.length %> | 
        Major: <%= data.severityCategories.major.length %> | 
        Minor: <%= data.severityCategories.minor.length %> | 
        Maintenance: <%= data.severityCategories.maintenance.length %>
      </p>
    </div>
  </div>

  <!-- Detailed Sections -->
  <% data.sections.forEach((section, index) => { %>
    <div class="inspection-section" style="<%= index === 0 ? 'page-break-before: always;' : '' %>">
      <div class="section-header">
        <h2><%= index + 1 %>. <%= section.name %></h2>
      </div>
      <div class="section-content">
        <% 
        const deficientItems = section.lineItems.filter(item => item.status === 'D');
        const normalItems = section.lineItems.filter(item => item.status !== 'D');
        %>
        
        <% if (deficientItems.length > 0) { %>
          <h3 style="color: #dc3545; margin-bottom: 15px;">Issues Found</h3>
          <% deficientItems.forEach(item => { %>
            <div class="issue-card issue-major">
              <h4><%= item.name %></h4>
              <% item.comments.forEach(comment => { %>
                <p style="margin: 10px 0;"><%= comment.text || 'Issue documented - see photos' %></p>
                <% if (comment.photos && comment.photos.length > 0) { %>
                  <div class="photo-grid">
                    <% comment.photos.slice(0, 3).forEach(photo => { %>
                      <img src="<%= photo %>" alt="Issue Photo" />
                    <% }) %>
                  </div>
                <% } %>
              <% }) %>
            </div>
          <% }) %>
        <% } %>
        
        <% if (normalItems.length > 0) { %>
          <h3 style="color: #28a745; margin-top: 20px; margin-bottom: 15px;">✓ Items Inspected</h3>
          <ul style="padding-left: 20px;">
            <% normalItems.forEach(item => { %>
              <li style="margin: 5px 0;"><%= item.name %> - Operating normally</li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </div>
  <% }) %>

  <!-- Footer -->
  <div class="report-footer">
    <p>This report is confidential and prepared exclusively for <%= data.property.client %></p>
    <p>© 2025 Professional Home Inspection Services. All rights reserved.</p>
  </div>
</body>
</html>